{
  "name": "warhammerdiorama",
  "main": "worker.mjs",
  "compatibility_date": "2025-04-01",
  "build": {
    "command": "node prepare-assets.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "warhammerdiorama"
    }
  ]
}
